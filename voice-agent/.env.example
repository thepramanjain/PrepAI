# ==================================================
# PrepAI Voice Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ==================================================

# --- LiveKit Cloud ---
# Get these from https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Google Gemini (via livekit-plugins-google) ---
# Use your existing GEMINI_API_KEY from the backend .env
# livekit-plugins-google reads this as GOOGLE_API_KEY
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Gemini Model ---
# gemini-2.5-flash-native-audio-preview: native speech-to-speech (recommended)
# This handles STT + LLM + TTS in a single model call
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview

# --- PrepAI Backend URL ---
# The backend the voice agent calls to fetch interview context
# and store responses/transcripts
PREPAI_BACKEND_URL=http://localhost:8000

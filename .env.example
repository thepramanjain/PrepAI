# ==================================================
# PrepAI — Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# ==================================================

# --- MongoDB ---
MONGODB_URI=
# Example: mongodb://localhost:27017/prepai
# Example: mongodb+srv://user:pass@cluster.mongodb.net/prepai

# --- Authentication ---
JWT_SECRET=
# A long random string for signing JWT tokens

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
# Use Gemini free-tier models

# --- LiveKit (Voice Agent) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=
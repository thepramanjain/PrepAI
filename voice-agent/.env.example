# ==================================================
# PrepAI Voice Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ==================================================

# --- LiveKit Cloud / Server ---
# Get these from https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Google Gemini Live (Native Audio) ---
# Supports either GOOGLE_API_KEY or GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck

# --- PrepAI Backend URL ---
PREPAI_BACKEND_URL=http://localhost:8000

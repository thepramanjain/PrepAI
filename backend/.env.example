# ==================================================
# PrepAI Backend — Environment Variables
# ==================================================
# Copy this file to .env and adjust values as needed.
# NEVER commit .env with real secrets.
# ==================================================

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=prepai

APP_NAME=PrepAI Backend
APP_VERSION=1.0.0
DEBUG=True

# Generative AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================================================
# Phase 10 — Agentic AI (OpenRouter + GPT-4o)
# ==================================================
# Sign up at https://openrouter.ai to get a key.
# NEVER commit your real key. NEVER expose to frontend.
# --------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Optional — sent as HTTP-Referer and X-Title headers to OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PrepAI
